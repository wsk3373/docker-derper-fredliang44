# DERP 配置
DERP_IMAGE=fredliang44/derper:latest
DERP_HOSTNAME=derp-aly.grep2000.com
DERP_CERT_MODE=manual
DERP_VERIFY_CLIENTS=false
DERP_STUN=true
DERP_HTTPS_PORT=555
DERP_STUN_PORT=3478
DERP_HTTP_PORT=80

# 映射主机端口
DERP_MAP_HTTPS_PORT=4443
DERP_MAP_STUN_PORT=3478

# 容器配置
TZ=Asia/Shanghai
DERP_RESTART_POLICY=unless-stopped
# DERP_HTTP_PORT=-1
